{
  "mcpServers": {
    "godot": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@coding-solo/godot-mcp"
      ],
      "env": {
        "GODOT_PATH": "/snap/bin/godot-4"
      }
    },
    "fal-ai": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "fal-ai-mcp"
      ],
      "env": {
        "FAL_KEY": "${FAL_KEY}"
      }
    }
  }
}
